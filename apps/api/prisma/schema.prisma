// Mashgool database schema (PostgreSQL via Prisma).
//
// Conventions (see CLAUDE.md): camelCase in TS, snake_case in the DB via
// @map/@@map; all PKs are UUIDs; all timestamps are UTC. Tables are plural.
//
// The schema grows per feature. Feature 7 introduced `User`; Feature 8 added
// `Client` (workspaces) and `AuditLog` (append-only action trail). Feature 9
// adds `Task` (and Client's back-relation to it).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients   Client[]
  auditLogs AuditLog[]

  @@map("users")
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
//
// A client workspace owned by one user. `shortCode` is the immutable prefix for
// task keys (e.g. `BS` → `BS-1`, `BS-2`) and is unique per user. `taskCounter`
// is the source of that number: it only ever increments (atomically, when a task
// is created — Feature 9) and is never decremented, so deleted task numbers are
// never reused. `isArchived` is a soft-archive flag — clients are archived, never
// soft-deleted; deletion is permanent and cascades to their tasks.
model Client {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  shortCode   String   @map("short_code")
  description String?
  color       String   @default("#4A90D9")
  isArchived  Boolean  @default(false) @map("is_archived")
  taskCounter Int      @default(0) @map("task_counter")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@unique([userId, shortCode])
  @@index([userId])
  @@index([userId, isArchived])
  @@map("clients")
}

// ─── TASK ────────────────────────────────────────────────────────────────────
//
// A unit of work inside a client workspace. `taskKey` is the immutable, per-client
// human key (e.g. `BS-1`) — generated server-side from the client's `shortCode`
// and an atomic increment of `Client.taskCounter` (see task-key.service.ts), so
// concurrent creates never collide and deleted numbers are never reused. Tasks
// are owned transitively through their client; every query is scoped by the
// owning user via the `client` relation. `boardOrder` backs manual card ordering
// on the Scrum board (Feature 10) — unused for now, defaults to 0.
model Task {
  id             String         @id @default(uuid())
  clientId       String         @map("client_id")
  taskKey        String         @map("task_key")
  title          String
  description    String?
  notes          String?
  status         TaskStatus     @default(TODO)
  priority       Priority       @default(MEDIUM)
  dueDate        DateTime?      @map("due_date")
  boardOrder     Int            @default(0) @map("board_order")
  creationMethod CreationMethod @default(MANUAL) @map("creation_method")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, taskKey])
  @@index([clientId])
  @@index([clientId, status])
  @@index([clientId, dueDate])
  @@index([clientId, priority])
  @@map("tasks")
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────
//
// Append-only trail of significant actions. Rows are only ever inserted, never
// updated or deleted. `entityId` is nullable because some actions (sign in/out,
// auth failures) aren't tied to a specific entity. `metadata` stores extracted
// output fields only — never raw AI input or secrets. Writes are fire-and-forget
// (see audit.service.ts) so a failed insert never breaks the main operation.
model AuditLog {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  action      AuditAction
  entityType  EntityType? @map("entity_type")
  entityId    String?     @map("entity_id")
  description String
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, action])
  @@index([userId, entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum AuditAction {
  USER_SIGNED_IN
  USER_SIGNED_OUT
  USER_AUTH_FAILED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_ARCHIVED
  CLIENT_UNARCHIVED
  CLIENT_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_DELETED
  AI_EXTRACTION_TRIGGERED
  AI_TRANSCRIPTION_TRIGGERED

  @@map("audit_action")
}

enum EntityType {
  USER
  CLIENT
  TASK

  @@map("entity_type")
}

// Declaration order is significant: Postgres sorts an enum by the order its
// labels are defined, and Prisma's `orderBy` inherits that. LOW→URGENT means an
// ascending sort runs low-to-high and `desc` surfaces URGENT first (the natural
// "most important on top" ordering).
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED

  @@map("task_status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

enum CreationMethod {
  MANUAL
  PASTE_TO_TASK
  VOICE_TO_TASK

  @@map("creation_method")
}
